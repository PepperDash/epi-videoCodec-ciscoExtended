<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="7.0.0" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plugin classes with no Crestron dependencies, compiled in and tested directly. -->
    <Compile Include="..\src\Diagnostics\CodecTimings.cs" Link="Linked\CodecTimings.cs" />
    <Compile Include="..\src\CodecJson.cs" Link="Linked\CodecJson.cs" />
    <Compile Include="..\src\Framing\XapiStreamFramer.cs" Link="Linked\XapiStreamFramer.cs" />
    <Compile Include="..\src\Dispatch\XapiDispatcher.cs" Link="Linked\XapiDispatcher.cs" />
    <Compile Include="..\src\Dispatch\XapiRequestTracker.cs" Link="Linked\XapiRequestTracker.cs" />
    <Compile Include="..\src\Model\ValueProperty.cs" Link="Linked\ValueProperty.cs" />
    <Compile Include="..\src\Model\IdKeyedListConverter.cs" Link="Linked\IdKeyedListConverter.cs" />
    <Compile Include="..\src\Model\StateModelContractResolver.cs" Link="Linked\StateModelContractResolver.cs" />
    <Compile Include="..\src\WebexAuthentication.cs" Link="Linked\WebexAuthentication.cs" />  </ItemGroup>

  <ItemGroup>
    <!-- Rebuilds the plugin before tests run (no direct assembly reference / no Crestron deps pulled in). -->
    <ProjectReference Include="..\src\epi-videoCodec-ciscoExtended.4Series.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
